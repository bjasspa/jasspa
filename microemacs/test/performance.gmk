# test/performance.gmk - MicroEmacs console performance regression check
#
# Runs the fixed editing workload test/performance.emf against the console
# (mec) build, measures wall clock time and peak memory (maximum resident
# set size), splits the workload into gen / replace / dialog phases and
# writes everything as TEST: lines to test/perf/perf-output.txt so runs can
# be compared over time.
#
# Usage (from the microemacs directory):
#   make -f test/performance.gmk            # prep + run + report
#   make -f test/performance.gmk prep       # clean slate only
#   make -f test/performance.gmk run        # workload only
#   make -f test/performance.gmk report     # re-check existing results
#   make -f test/performance.gmk clean      # remove all results
#
# Options (command line overrides):
#   MAXWALL=<seconds>   fail the report when the run exceeds this wall time
#   MAXRSS=<kbytes>     fail the report when the run exceeds this peak RSS
#   TIMEOUT=<seconds>   hard kill for a hung run (default 120)
#   MEC=<path>          console binary (auto-detected: src/.linux*-release-mec/mec)
#
# The default goal is "prep run report" and the exit status comes from
# report, which is the last target - a failed workload therefore still
# produces the full result table (and the job summary of the GitHub action)
# before make returns non-zero. Only a missing binary aborts "run" early.
#
# The dialog close key is injected by this driver: the dialog phase blocks
# until it reads one from stdin (byte 0x07 = C-g). test/perf/perf-dialog.flag
# is the macro's "I am in the dialog phase" marker, but feeding on that alone
# is racy - a C-g arriving between the marker being written and the dialog
# being up aborts the macro itself instead of the dialog, and the run then
# sits here until TIMEOUT (this happened, about 1 run in 6). So exactly one
# key is fed, and only once the dialog has actually been drawn: the driver
# watches perf-mec.log for the button row of its box. A dialog we cannot
# recognise is fed after 20 polls (2s) anyway.
#
# The poll interval is the resolution of the dialog phase: the reported
# dialog-ms is "dialog open + wait for the close key" and is therefore a few
# hundred ms above the pure rendering cost - the same offset for every
# version, so comparisons stay valid.
#
# The workload text is pure ASCII, i.e. an ISO-8859-1 subset - ME26 has no
# unicode support, so nothing outside ISO-8859-1 is used anywhere.
#
# GNU make is required (used by all *.gmk files of this project).

.ONESHELL:
SHELL := /bin/sh
.NOTPARALLEL:

ROOT    := $(abspath $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))/..)
MEC     ?= $(firstword $(wildcard $(ROOT)/src/.linux*-release-mec/mec $(ROOT)/bin/*/mec))
TIMEOUT ?= 120
MAXWALL ?=
MAXRSS  ?=
WORK    := $(ROOT)/test/perf
OUT     := $(WORK)/perf-output.txt
MACRO   := @test/performance

# GNU time gives wall clock and maximum RSS in one run; without it the wall
# clock is measured around the run with date +%s%N and peak RSS is reported
# as "-".
#
# Note the order in the run recipe below: /usr/bin/time is OUTSIDE and
# timeout is INSIDE, i.e. time -> sh -c exec -> timeout -> mec. That is
# deliberate and needs both properties:
#   * timeout's direct child is mec itself, so SIGTERM and the -k SIGKILL
#     really reach a binary that ignores SIGTERM (ME does) - time can never
#     be signalled away from underneath us and always gets to write its file;
#   * ru_maxrss still ends up being mec's: the kernel accumulates cmaxrss
#     recursively when a parent reaps a child (kernel/exit.c wait_task_zombie),
#     so time's wait4() on timeout includes timeout's reaped child mec.
GNUTIME := $(shell /usr/bin/time -v true >/dev/null 2>&1 && echo yes)

.PHONY: all prep run report clean

all: prep run report

prep:
	@cd "$(ROOT)"
	rm -f $(WORK)/perf-*
	rm -rf $(WORK)/user
	mkdir -p $(WORK)/user
	echo "TEST:perf-date=$$(date -u +%Y-%m-%dT%H:%M:%SZ)" > $(OUT)
	echo "TEST:perf-binary=$(MEC)" >> $(OUT)

run:
	@cd "$(ROOT)"
	if [ -z "$(MEC)" ] || [ ! -x "$(MEC)" ]; then
		echo "ERROR: console binary not found: $(MEC)"
		echo "       build it first: cd src && ./build.sh -t c"
		exit 1
	fi
	echo "== mec: workload on $(MEC)"
	mkdir -p $(WORK)/user
	rm -f $(WORK)/perf-macro.out $(WORK)/perf-dialog.flag $(WORK)/perf-tmp.txt \
	      $(WORK)/perf-mec.time $(WORK)/perf-mec.stats $(WORK)/perf-mec.log \
	      $(WORK)/perf-run.active
	: > $(WORK)/perf-run.active
	{
		# The dialog phase blocks until it gets a key, so this side feeds it
		# C-g. C-g aborts *macro execution* whenever no dialog is reading it,
		# and there is a window between the macro writing
		# test/perf/perf-dialog.flag and insert-symbol actually putting the
		# dialog on screen - a C-g landing in that window kills the macro,
		# the marker is never cleared and the run then sits here until
		# TIMEOUT. That really happened (me_20260601, ~1 run in 6), so the
		# key is gated on the dialog having been drawn: "> Cancel <" is its
		# button row, written once per run by every version tested. Exactly
		# one key is fed, which also keeps the closing keystroke from racing
		# with the marker being cleared again.
		#
		# Bound the loop: if the binary dies without ever clearing the
		# marker the pipeline must still end shortly after TIMEOUT
		# (10 iterations per second == the 0.1s poll interval).
		left=$$(((( $(TIMEOUT) + 10) * 10)))
		fed=0
		seen=0
		idle=0
		while [ -f $(WORK)/perf-run.active ] && [ $$left -gt 0 ]; do
			if [ -s $(WORK)/perf-dialog.flag ] && [ $$fed -eq 0 ]; then
				if grep -q '> Cancel <' $(WORK)/perf-mec.log 2>/dev/null; then
					seen=1
				else
					idle=$$((idle + 1))
				fi
				# seen: dialog is up, feed it now. Fallback: a dialog we do
				# not recognise - feed it after 2s anyway, the macro is then
				# either blocked in a dialog or already dead, and one late
				# C-g makes neither case worse.
				if [ $$seen -eq 1 ] || [ $$idle -ge 20 ]; then
					printf '\007'
					fed=1
				fi
			fi
			sleep 0.1
			left=$$((left - 1))
		done
	} | {
		cmd="exec timeout -k 5 $(TIMEOUT) env MEPATH=$(ROOT)/macros MEUSERPATH=$(WORK)/user TERM=$${TERM:-xterm-256color} $(MEC) $(MACRO)"
		rc=0
		if [ -n "$(GNUTIME)" ]; then
			/usr/bin/time -v -o $(WORK)/perf-mec.time sh -c "$$cmd" || rc=$$?
		else
			# no GNU time: measure the wall clock ourselves. %N needs
			# GNU date (Ubuntu, MSYS2) - good enough for a fallback.
			s=$$(date +%s%N)
			sh -c "$$cmd" || rc=$$?
			e=$$(date +%s%N)
			awk -v s=$$s -v e=$$e 'BEGIN{printf "wall=%.3f\n",(e-s)/1000000000}' > $(WORK)/perf-mec.stats
			printf 'rss=-\n' >> $(WORK)/perf-mec.stats
		fi
		# mec is done - release the stdin writer, it waits for this file
		rm -f $(WORK)/perf-run.active
		exit $$rc
	} > $(WORK)/perf-mec.log 2>&1
	rc=$$?
	rm -f $(WORK)/perf-run.active $(WORK)/perf-dialog.flag
	if [ -n "$(GNUTIME)" ] && [ -s $(WORK)/perf-mec.time ]; then
		w=$$(awk -F': ' '/Elapsed \(wall clock\)/{print $$NF}' $(WORK)/perf-mec.time)
		wall=$$(awk -v t="$$w" 'BEGIN{n=split(t,a,":"); if(n==3) print a[1]*3600+a[2]*60+a[3]; else if(n==2) print a[1]*60+a[2]; else print t}')
		rss=$$(awk -F': ' '/Maximum resident/{print $$NF}' $(WORK)/perf-mec.time)
		[ -n "$$wall" ] || wall="-"
		[ -n "$$rss" ] || rss="-"
		printf 'wall=%s\nrss=%s\n' "$$wall" "$$rss" > $(WORK)/perf-mec.stats
	fi
	# the run was killed before either measurement could be written - say so
	# rather than reporting an empty number
	if [ ! -s $(WORK)/perf-mec.stats ]; then
		printf 'wall=-\nrss=-\n' > $(WORK)/perf-mec.stats
	fi
	wall=$$(sed -n 's/^wall=//p' $(WORK)/perf-mec.stats)
	rss=$$(sed -n 's/^rss=//p' $(WORK)/perf-mec.stats)
	{ echo "TEST:mec-wall=$$wall"; echo "TEST:mec-maxrss=$$rss"; } >> $(OUT)
	# split the raw $unix-time stamps written by the macro into milliseconds
	if [ -s $(WORK)/perf-macro.out ]; then
		awk -F= 'BEGIN{gs=ge=rs=re=ds=de=""} $$1=="TEST:gen-start"{gs=$$2} $$1=="TEST:gen-end"{ge=$$2} $$1=="TEST:replace-start"{rs=$$2} $$1=="TEST:replace-end"{re=$$2} $$1=="TEST:dialog-start"{ds=$$2} $$1=="TEST:dialog-end"{de=$$2} END{if(gs!=""&&ge!="") printf "TEST:gen-ms=%.0f\n",(ge-gs)*1000; if(rs!=""&&re!="") printf "TEST:replace-ms=%.0f\n",(re-rs)*1000; if(ds!=""&&de!="") printf "TEST:dialog-ms=%.0f\n",(de-ds)*1000; if(gs!=""&&de!="") printf "TEST:macro-total-ms=%.0f\n",(de-gs)*1000}' $(WORK)/perf-macro.out >> $(OUT)
		grep '^TEST:insert-symbol=' $(WORK)/perf-macro.out | sed 's/^TEST:/TEST:mec-macro-/' >> $(OUT)
	fi
	if [ $$rc -eq 0 ] && grep -q 'TEST:workload-complete=1' $(WORK)/perf-macro.out 2>/dev/null; then
		echo "TEST:mec-status=ok" >> $(OUT)
		echo "   wall=$$wall s  peak RSS=$$rss kB  [ok]"
	else
		if [ $$rc -eq 124 ] || [ $$rc -eq 137 ]; then st="timeout"; else st="failed"; fi
		echo "TEST:mec-status=$$st" >> $(OUT)
		echo "   FAIL: mec workload ($$st, rc=$$rc) - log tail:"
		tail -n 8 $(WORK)/perf-mec.log 2>/dev/null | sed 's/^/     /'
	fi

report:
	@cd "$(ROOT)"
	if [ ! -s $(OUT) ]; then
		echo "FAIL: no results - run 'make -f test/performance.gmk' first"
		exit 1
	fi
	echo "== performance results =="
	st=$$(sed -n 's/^TEST:mec-status=//p' $(OUT) | tail -n 1)
	w=$$(sed -n 's/^TEST:mec-wall=//p' $(OUT) | tail -n 1)
	r=$$(sed -n 's/^TEST:mec-maxrss=//p' $(OUT) | tail -n 1)
	fail=0
	case "$$st" in
	ok)
		echo "  mec: wall=$$w s  peak RSS=$$r kB  [ok]"
		g=$$(sed -n 's/^TEST:gen-ms=//p' $(OUT) | tail -n 1)
		rp=$$(sed -n 's/^TEST:replace-ms=//p' $(OUT) | tail -n 1)
		d=$$(sed -n 's/^TEST:dialog-ms=//p' $(OUT) | tail -n 1)
		t=$$(sed -n 's/^TEST:macro-total-ms=//p' $(OUT) | tail -n 1)
		echo "  phases: gen=$$g ms  replace=$$rp ms  dialog=$$d ms  total=$$t ms"
		if [ -n "$(MAXWALL)" ] && awk -v a="$$w" -v b="$(MAXWALL)" 'BEGIN{exit !(a>b)}'; then
			echo "  FAIL: wall $$w s exceeds MAXWALL=$(MAXWALL) s"
			fail=1
		fi
		if [ -n "$(MAXRSS)" ] && [ "$$r" != "-" ] && awk -v a="$$r" -v b="$(MAXRSS)" 'BEGIN{exit !(a>b)}'; then
			echo "  FAIL: peak RSS $$r kB exceeds MAXRSS=$(MAXRSS) kB"
			fail=1
		fi
		;;
	skipped)
		echo "  mec: skipped" ;;
	"")
		echo "  mec: not run"
		fail=1 ;;
	*)
		echo "  FAIL: mec workload $$st (details in $(WORK)/perf-mec.log)"
		fail=1 ;;
	esac
	if [ $$fail -eq 0 ]; then
		grep -q 'TEST:all-tests=complete' $(OUT) || echo "TEST:all-tests=complete" >> $(OUT)
		echo "PASS"
	else
		echo "FAIL"
	fi
	echo "--- $(OUT) ---"
	cat $(OUT)
	exit $$fail

clean:
	@cd "$(ROOT)"
	rm -f $(WORK)/perf-*
	rm -rf $(WORK)/user
