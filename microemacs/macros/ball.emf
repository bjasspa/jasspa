; ball
;
; Keys:
;   ?  or  h   show/hide the key help
;   space      cycle the bat: off -> horizontal -> vertical -> off
;   n / x      add a ball / remove a ball
;   s          change the size of the next ball added
;   r          reset
;   p          pause
;   .          run a single frame, for watching a collision resolve
;   a          the pointer as a lump of gravity: off -> pull -> push -> off
;   g          cycle gravity: normal -> moon -> none -> upside down
;   [ / ]      less / more bounce
;   c          ball to ball collisions on/off
;   button 1   drag a ball to pick it up, let go to throw it
;   button 3   drop a new ball under the pointer
;   wheel      trim gravity
;   q or C-g   quit
;
0 define-macro ball-scheme
  !iif &seq .Ball.sch "ERROR"  set-variable .Ball.sch $mode-line-scheme
!emacro
0 define-macro ball-setup
  set-variable .Ball.ms       16 ; target frame time in ms (16 == 60fps)
  set-variable .Ball.scale   100 ; fixed point units per character cell
  set-variable .Ball.aspect    2 ; how many times taller a cell is than wide
  set-variable .Ball.gravity  22 ; downward acceleration
  set-variable .Ball.damp     76 ; wall bounce, percentage of speed kept
  set-variable .Ball.pdamp    88 ; bat bounce, percentage of speed kept
  set-variable .Ball.bdamp    90 ; ball to ball bounce, percentage kept
  set-variable .Ball.fric     14 ; how quickly a rolling ball is slowed
  set-variable .Ball.stopv    28 ; below this a resting ball is pinned still
  set-variable .Ball.maxv    900 ; speed limit, stops balls tunnelling
  set-variable .Ball.spin     18 ; % of the off-centre bat hit added sideways
  set-variable .Ball.punch    70 ; % of the bat's own speed added on impact
  set-variable .Ball.ride     35 ; % of the bat's speed a resting ball takes
  set-variable .Ball.throw   160 ; % of hand speed given to a thrown ball
  set-variable .Ball.padlen    5 ; bat half length in cells
  set-variable .Ball.padmaxv 400 ; the fastest the bat is allowed to swing
  set-variable .Ball.maxn     30 ; most balls allowed at once
  set-variable .Ball.start     1 ; balls to begin with
  set-variable .Ball.wellg    45 ; pull of the pointer well, per frame per frame
  set-variable .Ball.gmax    200 ; how far the wheel may wind gravity either way
  set-variable .Ball.shp0  "|1|"
  set-variable .Ball.shp1  "|1|2|1|"
  set-variable .Ball.shp2  "|1|2|3|2|1|"
  set-variable .Ball.shp3  "|2|3|4|5|4|3|2|"
  set-variable .Ball.shpr  "|0|1|2|3|"
  set-variable .Ball.shpc  "|1|2|3|5|"
  set-variable .Ball.rmax  &mul &mul 2 &lget .Ball.shpc 4 .Ball.scale
  set-variable .Ball.blank " "
  !while &les &len .Ball.blank 512
    set-variable .Ball.blank &cat .Ball.blank .Ball.blank
  !done
  set-variable .Ball.cols ""
  set-variable #l1 "|hlred|hlgreen|hlyellow|hlblue|hlmagenta|"
  set-variable #l0 0
  !while &les &set #l0 &add #l0 1 &add &llen #l1 1
    set-variable .Ball.sch &ind &cat ".scheme." &lget #l1 #l0
    ball-scheme
    set-variable .Ball.cols &cat &cat .Ball.cols "|" .Ball.sch
  !done
  set-variable .Ball.cols &cat .Ball.cols "|"
  set-variable .Ball.sch .scheme.hlcyan
  ball-scheme
  set-variable .Ball.padsch .Ball.sch
  set-variable .Ball.sch .scheme.hlwhite
  ball-scheme
  set-variable .Ball.hlpsch .Ball.sch
  set-variable .Ball.bgsch  $global-scheme
  set-variable .Ball.hudsch $mode-line-scheme
  set-variable .Ball.help "|                                          | ball - a bouncing ball playground        |                                          |  space    bat off / across / upright     |  button 1 pick a ball up and throw it    |  button 3 drop a new ball                |  a        pointer pulls / pushes         |  n  x     add / remove a ball            |  s        size of the next ball          |  g  wheel gravity                        |  [  ]     less / more bounce             |  c        ball to ball collisions        |  p  .     pause / step one frame         |  r        reset                          |  ?  h     hide this help                 |  q  C-g   quit                           |                                          |"
  set-variable .Ball.n        0
  set-variable .Ball.grab     0
  set-variable .Ball.padmode  0
  set-variable .Ball.paused   0
  set-variable .Ball.helpon   0
  set-variable .Ball.collide  1
  set-variable .Ball.newsz   -1
  set-variable .Ball.gmode    0
  set-variable .Ball.well     0
  set-variable .Ball.dirty    1
  set-variable .Ball.sep      0
  set-variable .Ball.step     0
  set-variable .Ball.prow    -1
  set-variable .Ball.pcol    -1
  set-variable .Ball.pdrawn   0
  set-variable .Ball.pvy      0
  set-variable .Ball.pvx      0
!emacro
0 define-macro ball-add
  !iif &gre &add .Ball.n 1 .Ball.maxn  !return
  set-variable .Ball.n &add .Ball.n 1
  set-variable #l0 .Ball.n
  set-variable #l1 .Ball.newsz
  !iif &les #l1 0  set-variable #l1 &mod $random 4
  set-variable #l2 &lget .Ball.shpr &add #l1 1
  set-variable #l3 &lget .Ball.shpc &add #l1 1
  set-variable #l4 .Ball.newy
  set-variable #l5 .Ball.newx
  !iif &les #l4 &add .Ball.top #l2  set-variable #l4 &add .Ball.top #l2
  !iif &gre #l4 &sub .Ball.bot #l2  set-variable #l4 &sub .Ball.bot #l2
  !iif &les #l5 &add .Ball.lft #l3  set-variable #l5 &add .Ball.lft #l3
  !iif &gre #l5 &sub .Ball.rgt #l3  set-variable #l5 &sub .Ball.rgt #l3
  set-variable &ind &cat ".Ball.y"  #l0 &mul #l4 .Ball.scale
  set-variable &ind &cat ".Ball.x"  #l0 &mul #l5 .Ball.scale
  set-variable &ind &cat ".Ball.vy" #l0 &sub &mod $random 120 60
  set-variable &ind &cat ".Ball.vx" #l0 &sub &mod $random 240 120
  set-variable &ind &cat ".Ball.sz" #l0 #l1
  set-variable &ind &cat ".Ball.ry" #l0 #l2
  set-variable &ind &cat ".Ball.rx" #l0 #l3
  set-variable &ind &cat ".Ball.sc" #l0 &lget .Ball.cols &add &mod $random &llen .Ball.cols 1
  set-variable &ind &cat ".Ball.dy" #l0 -1
  set-variable &ind &cat ".Ball.dx" #l0 -1
  set-variable &ind &cat ".Ball.ds" #l0 #l1
  set-variable .Ball.dirty 1
!emacro
0 define-macro ball-remove
  !iif &les .Ball.n 1  !return
  !iif &equ .Ball.grab .Ball.n  set-variable .Ball.grab 0
  set-variable #l0 &ind &cat ".Ball.dy" .Ball.n
  !if &gre #l0 -1
    set-variable .Ball.brow #l0
    set-variable .Ball.bcol &ind &cat ".Ball.dx" .Ball.n
    set-variable .Ball.bsz  &ind &cat ".Ball.ds" .Ball.n
    set-variable .Ball.bsch .Ball.bgsch
    ball-blit
  !endif
  set-variable .Ball.n &sub .Ball.n 1
  set-variable .Ball.redraw 1
  set-variable .Ball.dirty 1
!emacro
0 define-macro ball-reset
  !while &gre .Ball.n 0
    ball-remove
  !done
  set-variable .Ball.grab 0
  set-variable #l1 &sub .Ball.rgt 11
  !iif &les #l1 1  set-variable #l1 1
  set-variable #l0 0
  !while &les &set #l0 &add #l0 1 &add .Ball.start 1
    set-variable .Ball.newy &add .Ball.top &mod $random 3
    set-variable .Ball.newx &add 6 &mod $random #l1
    ball-add
  !done
  set-variable .Ball.redraw 1
!emacro
0 define-macro ball-blit
  set-variable #l0 &lget .Ball.shpr &add .Ball.bsz 1
  set-variable #l1 &ind &cat ".Ball.shp" .Ball.bsz
  set-variable #l2 &neg #l0
  !repeat
    set-variable #l3 &add .Ball.brow #l2
    !if &and &gre #l3 -1 &les #l3 $frame-depth
      set-variable #l4 &lget #l1 &add &add #l2 #l0 1
      3 screen-poke #l3 &sub .Ball.bcol #l4 .Ball.bsch &lef .Ball.blank &add &mul #l4 2 1
    !endif
    set-variable #l2 &add #l2 1
  !until &gre #l2 #l0
!emacro
0 define-macro ball-padblit
  set-variable #l0 .Ball.pr0
  !while &les #l0 &add .Ball.pr1 1
    !if &and &gre #l0 -1 &les #l0 $frame-depth
      3 screen-poke #l0 .Ball.pc0 .Ball.bsch &lef .Ball.blank &add &sub .Ball.pc1 .Ball.pc0 1
    !endif
    set-variable #l0 &add #l0 1
  !done
!emacro
0 define-macro ball-render
  set-variable #l8 .Ball.redraw
  set-variable #l0 0
  !while &les &set #l0 &add #l0 1 &add .Ball.n 1
    !if &not &equ &div &ind &cat ".Ball.y" #l0 .Ball.scale &ind &cat ".Ball.dy" #l0
      set-variable #l8 1
    !elif &not &equ &div &ind &cat ".Ball.x" #l0 .Ball.scale &ind &cat ".Ball.dx" #l0
      set-variable #l8 1
    !endif
  !done
  !iif &and &not #l8 &not .Ball.padmoved  !return
  set-variable .Ball.bsch .Ball.bgsch
  !if .Ball.pdrawn
    set-variable .Ball.pr0 .Ball.pdr0
    set-variable .Ball.pr1 .Ball.pdr1
    set-variable .Ball.pc0 .Ball.pdc0
    set-variable .Ball.pc1 .Ball.pdc1
    ball-padblit
    set-variable .Ball.pdrawn 0
  !endif
  set-variable #l0 0
  !while &les &set #l0 &add #l0 1 &add .Ball.n 1
    set-variable #l1 &ind &cat ".Ball.dy" #l0
    !if &gre #l1 -1
      set-variable .Ball.brow #l1
      set-variable .Ball.bcol &ind &cat ".Ball.dx" #l0
      set-variable .Ball.bsz  &ind &cat ".Ball.ds" #l0
      ball-blit
      set-variable &ind &cat ".Ball.dy" #l0 -1
    !endif
  !done
  !if .Ball.padmode
    set-variable .Ball.pr0 .Ball.padr0
    set-variable .Ball.pr1 .Ball.padr1
    set-variable .Ball.pc0 .Ball.padc0
    set-variable .Ball.pc1 .Ball.padc1
    set-variable .Ball.bsch .Ball.padsch
    ball-padblit
    set-variable .Ball.pdr0 .Ball.pr0
    set-variable .Ball.pdr1 .Ball.pr1
    set-variable .Ball.pdc0 .Ball.pc0
    set-variable .Ball.pdc1 .Ball.pc1
    set-variable .Ball.pdrawn 1
  !endif
  set-variable #l0 0
  !while &les &set #l0 &add #l0 1 &add .Ball.n 1
    set-variable #l1 &div &ind &cat ".Ball.y" #l0 .Ball.scale
    set-variable #l2 &div &ind &cat ".Ball.x" #l0 .Ball.scale
    set-variable #l3 &ind &cat ".Ball.sz" #l0
    set-variable .Ball.brow #l1
    set-variable .Ball.bcol #l2
    set-variable .Ball.bsz  #l3
    set-variable .Ball.bsch &ind &cat ".Ball.sc" #l0
    ball-blit
    set-variable &ind &cat ".Ball.dy" #l0 #l1
    set-variable &ind &cat ".Ball.dx" #l0 #l2
    set-variable &ind &cat ".Ball.ds" #l0 #l3
  !done
  !iif .Ball.helpon  ball-help
  set-variable .Ball.redraw 0
  set-variable .Ball.padmoved 0
  1 screen-poke 0 0 .Ball.hudsch " "
!emacro
0 define-macro ball-hud
  set-variable #l0 &spr " n:%d/%d  g:%d  bnc:%d%%  bat:%s  hit:%s  well:%s  fps:%s%s  [?] keys" .Ball.n .Ball.maxn .Ball.gravity .Ball.damp &lget "|off|across|upright|" &add .Ball.padmode 1 &cond .Ball.collide "on" "off" &lget "|push|off|pull|" &add .Ball.well 2 .Ball.fps &cond .Ball.paused "  PAUSED" ""
  1 screen-poke 0 0 .Ball.hudsch &lef &cat #l0 .Ball.blank $frame-width
!emacro
0 define-macro ball-help
  set-variable #l0 &llen .Ball.help
  set-variable #l1 &div &sub $frame-depth #l0 2
  set-variable #l2 &div &sub $frame-width 42 2
  !iif &les #l1 0  set-variable #l1 0
  !iif &les #l2 0  set-variable #l2 0
  set-variable #l3 0
  !while &les &set #l3 &add #l3 1 &add #l0 1
    !if &les &add #l1 #l3 &sub $frame-depth 2
      3 screen-poke &add #l1 #l3 #l2 .Ball.hlpsch &lef &cat &lget .Ball.help #l3 .Ball.blank 42
    !endif
  !done
!emacro
0 define-macro ball-settle
  !iif &les &abs .Ball.cvy .Ball.stopv  set-variable .Ball.cvy 0
  !if &gre .Ball.cvx .Ball.fric
    set-variable .Ball.cvx &sub .Ball.cvx .Ball.fric
  !elif &les .Ball.cvx &neg .Ball.fric
    set-variable .Ball.cvx &add .Ball.cvx .Ball.fric
  !else
    set-variable .Ball.cvx 0
  !endif
!emacro
0 define-macro ball-collide-pad
  set-variable #l0 &mul &sub &sub .Ball.padr0 .Ball.cry 1 .Ball.scale
  set-variable #l1 &mul &add &add .Ball.padr1 .Ball.cry 1 .Ball.scale
  set-variable #l2 &mul &sub &sub .Ball.padc0 .Ball.crx 1 .Ball.scale
  set-variable #l3 &mul &add &add .Ball.padc1 .Ball.crx 1 .Ball.scale
  !if &and &gre .Ball.cx #l2 &les .Ball.cx #l3
    set-variable #l4 0
    !if &and &not &gre .Ball.coy #l0 &not &les .Ball.cy #l0
      set-variable .Ball.cy #l0
      set-variable #l4 1
    !elif &and &not &les .Ball.coy #l1 &not &gre .Ball.cy #l1
      set-variable .Ball.cy #l1
      set-variable #l4 1
    !endif
    !if #l4
      set-variable .Ball.cvy &add &div &mul &neg .Ball.cvy .Ball.pdamp 100 &div &mul .Ball.pvy .Ball.punch 100
      !if &les &abs .Ball.cvy .Ball.stopv
        set-variable .Ball.cvy 0
        set-variable .Ball.cvx &add .Ball.cvx &div &mul &sub .Ball.pvx .Ball.cvx .Ball.ride 100
      !else
        set-variable #l5 &div &mul &add .Ball.padc0 .Ball.padc1 .Ball.scale 2
        set-variable .Ball.cvx &add .Ball.cvx &div &mul &sub .Ball.cx #l5 .Ball.spin 100
        set-variable .Ball.cvx &add .Ball.cvx &div &mul .Ball.pvx .Ball.punch 200
      !endif
      set-variable .Ball.chit 1
      !return
    !endif
  !endif
  !if &and &gre .Ball.cy #l0 &les .Ball.cy #l1
    set-variable #l4 0
    !if &and &not &gre .Ball.cox #l2 &not &les .Ball.cx #l2
      set-variable .Ball.cx #l2
      set-variable #l4 1
    !elif &and &not &les .Ball.cox #l3 &not &gre .Ball.cx #l3
      set-variable .Ball.cx #l3
      set-variable #l4 1
    !endif
    !if #l4
      set-variable .Ball.cvx &add &div &mul &neg .Ball.cvx .Ball.pdamp 100 &div &mul .Ball.pvx .Ball.punch 100
      set-variable #l5 &div &mul &add .Ball.padr0 .Ball.padr1 .Ball.scale 2
      set-variable .Ball.cvy &add .Ball.cvy &div &mul &sub .Ball.cy #l5 .Ball.spin 100
      set-variable .Ball.cvy &add .Ball.cvy &div &mul .Ball.pvy .Ball.punch 200
      set-variable .Ball.chit 1
    !endif
  !endif
!emacro
0 define-macro ball-collide-pair
  set-variable #l0 .Ball.pdy
  set-variable #l1 .Ball.pdx
  set-variable #l2 .Ball.prr
  set-variable #l3 &add &mul #l0 #l0 &mul #l1 #l1
  !iif &gre #l3 &mul #l2 #l2  !return
  !iif &les #l3 1  !return
  set-variable #l3 &spr "%.0f" &fsq #l3
  !if &equ .Ball.pa .Ball.grab
    set-variable .Ball.pfa 0
    set-variable .Ball.pfb 2
  !elif &equ .Ball.pb .Ball.grab
    set-variable .Ball.pfa 2
    set-variable .Ball.pfb 0
  !else
    set-variable .Ball.pfa 1
    set-variable .Ball.pfb 1
  !endif
  set-variable #l4 &div &mul #l0 1000 #l3
  set-variable #l5 &div &mul #l1 1000 #l3
  set-variable #l6 &div &sub #l2 #l3 2
  set-variable #l7 &div &div &mul #l6 #l4 1000 .Ball.aspect
  set-variable #l8 &div &mul #l6 #l5 1000
  set-variable &ind &cat ".Ball.y" .Ball.pa &add &ind &cat ".Ball.y" .Ball.pa &mul #l7 .Ball.pfa
  set-variable &ind &cat ".Ball.x" .Ball.pa &add &ind &cat ".Ball.x" .Ball.pa &mul #l8 .Ball.pfa
  set-variable &ind &cat ".Ball.y" .Ball.pb &sub &ind &cat ".Ball.y" .Ball.pb &mul #l7 .Ball.pfb
  set-variable &ind &cat ".Ball.x" .Ball.pb &sub &ind &cat ".Ball.x" .Ball.pb &mul #l8 .Ball.pfb
  set-variable .Ball.sep 1
  set-variable #l6 &mul &sub &ind &cat ".Ball.vy" .Ball.pa &ind &cat ".Ball.vy" .Ball.pb .Ball.aspect
  set-variable #l7 &sub &ind &cat ".Ball.vx" .Ball.pa &ind &cat ".Ball.vx" .Ball.pb
  set-variable #l9 &div &add &mul #l6 #l4 &mul #l7 #l5 1000
  !iif &gre #l9 -1  !return
  set-variable #l9 &div &mul &neg #l9 &add 100 .Ball.bdamp 200
  set-variable #l6 &div &div &mul #l9 #l4 1000 .Ball.aspect
  set-variable #l7 &div &mul #l9 #l5 1000
  set-variable &ind &cat ".Ball.vy" .Ball.pa &add &ind &cat ".Ball.vy" .Ball.pa &mul #l6 .Ball.pfa
  set-variable &ind &cat ".Ball.vx" .Ball.pa &add &ind &cat ".Ball.vx" .Ball.pa &mul #l7 .Ball.pfa
  set-variable &ind &cat ".Ball.vy" .Ball.pb &sub &ind &cat ".Ball.vy" .Ball.pb &mul #l6 .Ball.pfb
  set-variable &ind &cat ".Ball.vx" .Ball.pb &sub &ind &cat ".Ball.vx" .Ball.pb &mul #l7 .Ball.pfb
!emacro
0 define-macro ball-physics
  set-variable #l0 0
  !while &les &set #l0 &add #l0 1 &add .Ball.n 1
    set-variable .Ball.cy  &ind &cat ".Ball.y"  #l0
    set-variable .Ball.cx  &ind &cat ".Ball.x"  #l0
    set-variable .Ball.cvy &ind &cat ".Ball.vy" #l0
    set-variable .Ball.cvx &ind &cat ".Ball.vx" #l0
    set-variable .Ball.cry &ind &cat ".Ball.ry" #l0
    set-variable .Ball.crx &ind &cat ".Ball.rx" #l0
    set-variable .Ball.coy .Ball.cy
    set-variable .Ball.cox .Ball.cx
    set-variable #l1 &mul &add .Ball.top .Ball.cry .Ball.scale
    set-variable #l2 &mul &sub .Ball.bot .Ball.cry .Ball.scale
    set-variable #l3 &mul &add .Ball.lft .Ball.crx .Ball.scale
    set-variable #l4 &mul &sub .Ball.rgt .Ball.crx .Ball.scale
    !if &equ #l0 .Ball.grab
      set-variable .Ball.cy &mul $mouse-y .Ball.scale
      set-variable .Ball.cx &mul $mouse-x .Ball.scale
      !iif &les .Ball.cy #l1  set-variable .Ball.cy #l1
      !iif &gre .Ball.cy #l2  set-variable .Ball.cy #l2
      !iif &les .Ball.cx #l3  set-variable .Ball.cx #l3
      !iif &gre .Ball.cx #l4  set-variable .Ball.cx #l4
      set-variable .Ball.cvy &div &add &mul 2 .Ball.cvy &sub .Ball.cy .Ball.coy 3
      set-variable .Ball.cvx &div &add &mul 2 .Ball.cvx &sub .Ball.cx .Ball.cox 3
    !else
      set-variable .Ball.cvy &add .Ball.cvy .Ball.gravity
      !if .Ball.well
        set-variable #l5 &mul &sub &mul $mouse-y .Ball.scale .Ball.cy .Ball.aspect
        set-variable #l6 &sub &mul $mouse-x .Ball.scale .Ball.cx
        set-variable #l7 &add &mul #l5 #l5 &mul #l6 #l6
        !if &gre #l7 &mul .Ball.scale .Ball.scale
          set-variable #l7 &spr "%.0f" &fsq #l7
          set-variable #l8 &div &mul &mul .Ball.well .Ball.wellg .Ball.scale #l7
          set-variable .Ball.cvy &add .Ball.cvy &div &div &mul #l8 #l5 #l7 .Ball.aspect
          set-variable .Ball.cvx &add .Ball.cvx &div &mul #l8 #l6 #l7
        !endif
      !endif
      !iif &gre .Ball.cvy .Ball.maxv  set-variable .Ball.cvy .Ball.maxv
      !iif &les .Ball.cvy &neg .Ball.maxv  set-variable .Ball.cvy &neg .Ball.maxv
      !iif &gre .Ball.cvx .Ball.maxv  set-variable .Ball.cvx .Ball.maxv
      !iif &les .Ball.cvx &neg .Ball.maxv  set-variable .Ball.cvx &neg .Ball.maxv
      set-variable .Ball.cy &add .Ball.cy .Ball.cvy
      set-variable .Ball.cx &add .Ball.cx .Ball.cvx
      !if .Ball.padmode
        set-variable .Ball.chit 0
        ball-collide-pad
      !endif
      !if &les .Ball.cy #l1
        set-variable .Ball.cy #l1
        set-variable .Ball.cvy &div &mul &neg .Ball.cvy .Ball.damp 100
        !iif &les .Ball.gravity 0  ball-settle
      !elif &gre .Ball.cy #l2
        set-variable .Ball.cy #l2
        set-variable .Ball.cvy &div &mul &neg .Ball.cvy .Ball.damp 100
        !iif &gre .Ball.gravity 0  ball-settle
      !endif
      !if &les .Ball.cx #l3
        set-variable .Ball.cx #l3
        set-variable .Ball.cvx &div &mul &neg .Ball.cvx .Ball.damp 100
      !elif &gre .Ball.cx #l4
        set-variable .Ball.cx #l4
        set-variable .Ball.cvx &div &mul &neg .Ball.cvx .Ball.damp 100
      !endif
    !endif
    set-variable &ind &cat ".Ball.y"  #l0 .Ball.cy
    set-variable &ind &cat ".Ball.x"  #l0 .Ball.cx
    set-variable &ind &cat ".Ball.vy" #l0 .Ball.cvy
    set-variable &ind &cat ".Ball.vx" #l0 .Ball.cvx
    !iif &or &not &equ .Ball.cy .Ball.coy &not &equ .Ball.cx .Ball.cox  set-variable #l9 1
  !done
  !if &and &and .Ball.collide &gre .Ball.n 1 &or #l9 .Ball.dirty
    set-variable .Ball.dirty 0
    set-variable .Ball.sep 0
    set-variable #l0 0
    !while &les &set #l0 &add #l0 1 .Ball.n
      set-variable #l2 &ind &cat ".Ball.y"  #l0
      set-variable #l3 &ind &cat ".Ball.x"  #l0
      set-variable #l4 &ind &cat ".Ball.rx" #l0
      set-variable #l1 #l0
      !while &les &set #l1 &add #l1 1 &add .Ball.n 1
        set-variable #l6 &sub #l3 &ind &cat ".Ball.x" #l1
        !if &not &gre &abs #l6 .Ball.rmax
          set-variable #l5 &mul &add #l4 &ind &cat ".Ball.rx" #l1 .Ball.scale
          !if &not &gre &abs #l6 #l5
            set-variable #l7 &mul &sub #l2 &ind &cat ".Ball.y" #l1 .Ball.aspect
            !if &not &gre &abs #l7 #l5
              set-variable .Ball.pa #l0
              set-variable .Ball.pb #l1
              set-variable .Ball.pdx #l6
              set-variable .Ball.pdy #l7
              set-variable .Ball.prr #l5
              ball-collide-pair
              set-variable #l2 &ind &cat ".Ball.y" #l0
              set-variable #l3 &ind &cat ".Ball.x" #l0
            !endif
          !endif
        !endif
      !done
    !done
    !if .Ball.sep
      set-variable #l0 0
      !while &les &set #l0 &add #l0 1 &add .Ball.n 1
        set-variable #l1 &mul &add .Ball.top &ind &cat ".Ball.ry" #l0 .Ball.scale
        set-variable #l2 &mul &sub .Ball.bot &ind &cat ".Ball.ry" #l0 .Ball.scale
        set-variable #l3 &mul &add .Ball.lft &ind &cat ".Ball.rx" #l0 .Ball.scale
        set-variable #l4 &mul &sub .Ball.rgt &ind &cat ".Ball.rx" #l0 .Ball.scale
        !iif &les &ind &cat ".Ball.y" #l0 #l1  set-variable &ind &cat ".Ball.y" #l0 #l1
        !iif &gre &ind &cat ".Ball.y" #l0 #l2  set-variable &ind &cat ".Ball.y" #l0 #l2
        !iif &les &ind &cat ".Ball.x" #l0 #l3  set-variable &ind &cat ".Ball.x" #l0 #l3
        !iif &gre &ind &cat ".Ball.x" #l0 #l4  set-variable &ind &cat ".Ball.x" #l0 #l4
      !done
    !endif
  !endif
!emacro
0 define-macro ball-paddle
  !iif &not .Ball.padmode  !return
  !if .Ball.grab
    set-variable .Ball.pvy 0
    set-variable .Ball.pvx 0
    !return
  !endif
  !if &equ .Ball.padmode 1
    set-variable #l2 0
    set-variable #l3 .Ball.padlen
  !else
    set-variable #l2 .Ball.padlen
    set-variable #l3 0
  !endif
  set-variable #l0 $mouse-y
  set-variable #l1 $mouse-x
  !iif &les #l0 &add .Ball.top #l2  set-variable #l0 &add .Ball.top #l2
  !iif &gre #l0 &sub .Ball.bot #l2  set-variable #l0 &sub .Ball.bot #l2
  !iif &les #l1 &add .Ball.lft #l3  set-variable #l1 &add .Ball.lft #l3
  !iif &gre #l1 &sub .Ball.rgt #l3  set-variable #l1 &sub .Ball.rgt #l3
  !if &or &not &equ #l0 .Ball.prow &not &equ #l1 .Ball.pcol
    set-variable .Ball.padmoved 1
  !endif
  !if &les .Ball.prow 0
    set-variable .Ball.pvy 0
    set-variable .Ball.pvx 0
  !else
    set-variable .Ball.pvy &mul &sub #l0 .Ball.prow .Ball.scale
    set-variable .Ball.pvx &mul &sub #l1 .Ball.pcol .Ball.scale
    !iif &gre .Ball.pvy .Ball.padmaxv  set-variable .Ball.pvy .Ball.padmaxv
    !iif &les .Ball.pvy &neg .Ball.padmaxv  set-variable .Ball.pvy &neg .Ball.padmaxv
    !iif &gre .Ball.pvx .Ball.padmaxv  set-variable .Ball.pvx .Ball.padmaxv
    !iif &les .Ball.pvx &neg .Ball.padmaxv  set-variable .Ball.pvx &neg .Ball.padmaxv
  !endif
  set-variable .Ball.prow #l0
  set-variable .Ball.pcol #l1
  set-variable .Ball.padr0 &sub #l0 #l2
  set-variable .Ball.padr1 &add #l0 #l2
  set-variable .Ball.padc0 &sub #l1 #l3
  set-variable .Ball.padc1 &add #l1 #l3
!emacro
0 define-macro ball-tick
  !iif &not .Ball.running  !return
  set-variable #l0 $unix-time
  set-variable .Ball.bot &sub $frame-depth 3
  set-variable .Ball.rgt &sub $frame-width 1
  !if &or &not .Ball.paused .Ball.step
    set-variable .Ball.step 0
    ball-paddle
    ball-physics
  !endif
  ball-render
  set-variable .Ball.frame &add .Ball.frame 1
  !if &gre .Ball.frame 14
    set-variable .Ball.fps &spr "%.0f" &fdiv .Ball.frame &fsub $unix-time .Ball.fpst
    set-variable .Ball.fpst $unix-time
    set-variable .Ball.frame 0
    ball-hud
  !endif
  set-variable #l1 &sub .Ball.ms &spr "%.0f" &fmul 1000 &fsub $unix-time #l0
  !iif &les #l1 1  set-variable #l1 1
  !iif .Ball.running  #l1 create-callback ball-tick
!emacro
0 define-macro ball-clamp-gravity
  !iif &gre .Ball.gravity .Ball.gmax  set-variable .Ball.gravity .Ball.gmax
  !iif &les .Ball.gravity &neg .Ball.gmax  set-variable .Ball.gravity &neg .Ball.gmax
  ball-hud
!emacro
0 define-macro ball-cursor-hide
  !iif &sin "C" $mode-chars  -1 buffer-mode "cursor"
!emacro
0 define-macro ball-cursor-show
  !iif &sin "C" $mode-chars  1 buffer-mode "cursor"
!emacro
0 define-macro ball-set-bounce
  set-variable .Ball.pdamp &add .Ball.damp 12
  !iif &gre .Ball.pdamp 120  set-variable .Ball.pdamp 120
  ball-hud
!emacro
0 define-macro ball-forget
  set-variable #l0 0
  !while &les &set #l0 &add #l0 1 &add .Ball.n 1
    set-variable &ind &cat ".Ball.dy" #l0 -1
  !done
  set-variable .Ball.pdrawn 0
  set-variable .Ball.redraw 1
!emacro
0 define-macro ball-toggle-help
  set-variable .Ball.helpon &not .Ball.helpon
  set-variable .Ball.paused .Ball.helpon
  1 screen-update
  ball-forget
  ball-hud
!emacro
0 define-macro ball-quit
  !iif &not .Ball.running  !return
  set-variable .Ball.running 0
  -1 create-callback ball-tick
  set-variable $buffer-input .Ball.previnput
  ball-cursor-show
  1 screen-update
  ml-write "[ball: that's your lot]"
!emacro
0 define-macro ball-input
  !if &seq @cck "callback"
    !force execute-named-command @cc
    !return
  !endif
  !if &seq @cc "abort-command"
    ball-quit
    !abort
  !endif
  set-variable #l9 @cck
  !if &seq #l9 "mouse-pick-1"
    set-variable #l0 0
    !while &les &set #l0 &add #l0 1 &add .Ball.n 1
      !if &not &gre &abs &sub $mouse-y &div &ind &cat ".Ball.y" #l0 .Ball.scale &add &ind &cat ".Ball.ry" #l0 1
        !if &not &gre &abs &sub $mouse-x &div &ind &cat ".Ball.x" #l0 .Ball.scale &add &ind &cat ".Ball.rx" #l0 1
          set-variable .Ball.grab #l0
          set-variable #l0 .Ball.n
        !endif
      !endif
    !done
    !return
  !elif &seq #l9 "mouse-drop-1"
    !if .Ball.grab
      set-variable #l0 .Ball.grab
      set-variable &ind &cat ".Ball.vy" #l0 &div &mul &ind &cat ".Ball.vy" #l0 .Ball.throw 100
      set-variable &ind &cat ".Ball.vx" #l0 &div &mul &ind &cat ".Ball.vx" #l0 .Ball.throw 100
      set-variable .Ball.grab 0
    !endif
    !return
  !elif &seq #l9 "mouse-pick-3"
    set-variable .Ball.newy $mouse-y
    set-variable .Ball.newx $mouse-x
    ball-add
    ball-hud
    !return
  !elif &seq #l9 "mouse-wup"
    set-variable .Ball.gravity &add .Ball.gravity 4
    ball-clamp-gravity
    !return
  !elif &seq #l9 "mouse-wdown"
    set-variable .Ball.gravity &sub .Ball.gravity 4
    ball-clamp-gravity
    !return
  !endif
  !if &or &seq #l9 "?" &seq #l9 "h"
    ball-toggle-help
  !elif &or &seq #l9 "q" &seq #l9 "esc"
    ball-quit
  !elif &seq #l9 "space"
    set-variable .Ball.padmode &mod &add .Ball.padmode 1 3
    set-variable .Ball.prow -1
    set-variable .Ball.pcol -1
    set-variable .Ball.padmoved 1
    ball-hud
  !elif &seq #l9 "n"
    set-variable #l0 &sub .Ball.rgt 11
    !iif &les #l0 1  set-variable #l0 1
    set-variable .Ball.newy &add .Ball.top &mod $random 3
    set-variable .Ball.newx &add 6 &mod $random #l0
    ball-add
    ball-hud
  !elif &seq #l9 "x"
    ball-remove
    ball-hud
  !elif &seq #l9 "s"
    set-variable .Ball.newsz &con &gre .Ball.newsz 2 -1 &add .Ball.newsz 1
    ml-write &spr "[ball: new balls are %s]" &cond &les .Ball.newsz 0 "any size" &lget "|tiny|small|medium|large|" &add .Ball.newsz 1
  !elif &seq #l9 "r"
    ball-reset
    ball-hud
  !elif &seq #l9 "p"
    set-variable .Ball.paused &not .Ball.paused
    ball-hud
  !elif &seq #l9 "a"
    set-variable .Ball.well &con &gre .Ball.well 0 -1 &con &les .Ball.well 0 0 1
    ball-hud
  !elif &seq #l9 "."
    set-variable .Ball.paused 1
    set-variable .Ball.step 1
    ball-hud
  !elif &seq #l9 "g"
    set-variable .Ball.gmode &mod &add .Ball.gmode 1 4
    set-variable .Ball.gravity &lget "|22|5|0|-22|" &add .Ball.gmode 1
    ball-hud
  !elif &seq #l9 "["
    !iif &gre .Ball.damp 5  set-variable .Ball.damp &sub .Ball.damp 5
    ball-set-bounce
  !elif &seq #l9 "]"
    !iif &les .Ball.damp 120  set-variable .Ball.damp &add .Ball.damp 5
    ball-set-bounce
  !elif &seq #l9 "c"
    set-variable .Ball.collide &not .Ball.collide
    ball-hud
  !endif
!emacro
define-macro Ball
  !iif &equ .Ball.running 1  ball-quit
  ball-setup
  set-variable .Ball.top 1
  set-variable .Ball.lft 0
  set-variable .Ball.bot &sub $frame-depth 3
  set-variable .Ball.rgt &sub $frame-width 1
  !if &or &les &sub .Ball.bot .Ball.top 7 &les .Ball.rgt 13
    ml-write "[ball: this window is too small to play in]"
    !return
  !endif
  set-variable .Ball.padmoved 0
  set-variable .Ball.fps 0
  set-variable .Ball.frame 0
  set-variable .Ball.fpst $unix-time
  ball-reset
  set-variable .Ball.previnput $buffer-input
  set-variable $buffer-input ball-input
  ball-cursor-hide
  set-variable .Ball.running 1
  set-variable .Ball.redraw 1
  ball-hud
  .Ball.ms create-callback ball-tick
  ml-write "[ball: ? for help, q to quit]"
!emacro
