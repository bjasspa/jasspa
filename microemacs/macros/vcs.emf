;
; Synopsis:    Wrapper for all VCS systems
; Authors:     Steven Phillips
;
define-macro vcs-id
  !force set-variable #l0 @1
  !iif &not $status  set-variable #l0 $buffer-fname
  !if &seq "" #l0
    !iif &band @# 1  ml-write "[VCS Error: No file path given]"
    !abort
  !elif &seq &lget .ld 1 &lef #l0 &len &lget .ld 1
    set-variable #p8 &ind &cat ".vcs." &set #p9 &lget .li 1
    set-variable #l0 &lget .ld 1
  !elif &seq &lget .ld 2 &lef #l0 &len &lget .ld 2
    set-variable #p8 &ind &cat ".vcs." &set #p9 &lget .li 2
    set-variable #l0 &lget .ld 2
  !else
    !iif &not &seq "/" &rig #l0 -1  set-variable #l0 &lef #l0 &rsin "/" #l0
    !if &seq "D" &stat "t" &cat #l0 ".git"
      set-variable #p9 "git"
    !elif &seq "D" &stat "t" &cat #l0 ".svn"
      set-variable #p9 "svn"
    !elif &seq "D" &stat "t" &cat &set #l4 #l0 "CVS"
      set-variable #p9 "cvs"
    !else
      !while &gre &set #l1 &rsin "/" &lef #l0 -1 3
        !iif &seq "D" &stat "t" &cat &set #l0 &lef #l0 #l1 &set #l3 ".git"  !break
      !until &seq "D" &stat "t" &cat #l0 &set #l3 ".svn"  !break
      !if &gre #l1 3
        set-variable #p9 &rig #l3 1
      !else
        set-variable #l1 0
        !while &not &seq "" &set #l0 &reg &cat "/history/clearcase/" &inc #l1 1 ""
          !iif &seq &lef #l4 &len #l0 #l0  !break
        !done
        !if &seq #l0 ""
          !iif &band @# 1  ml-write &spr "[VCS Error: Failed to identify system used for %s]" #l4
          !abort
        !endif
        set-variable #p9 "cc"
      !endif
    !endif
    !if &not &exi &ind &cat ".vcs." #p9
      execute-file #p9
      !iif &not &exi &ind &cat ".vcs." #p9  -8 ml-write &spr "[VCS Error: %s not setup correctly]" #p9
    !endif
    set-variable #p8 &ind &cat ".vcs." #p9
    set-variable .ld &spr "|%s|%s|" #l0 &lget .ld 1
    set-variable .li &spr "|%s|%s|" #p9 &lget .li 1
  !endif
  !if &not @?
    ml-write &spr "VCS for \"%s\" is %s (%s)" #l0 &lget #p8 1 #p9
  !elif &band @# 2
    !if &not &exi &set #l0 &cat #p9 &set #l1 @2
      !force set-variable #l2 @3
      !iif &not $status  -8 ml-write &spr "[VCS Error: %s does not support %s]" &lget #p8 1 &rig #l1 1
      !iif &not &exi &set #l0 &cat #p9 #l2  -8 ml-write &spr "[VCS Error: %s does not support %s/%s]" &lget #p8 1 &rig #l1 1 &rig #l2 1
    !endif
    execute-named-command #l0
  !endif
!emacro
set-variable .vcs-id.ld "|:|:|"
set-variable .vcs-id.li "|||"

define-macro vcs
  3 vcs-id $buffer-fname ""
!emacro
define-macro vcs-add
  3 vcs-id $buffer-fname "-add"
!emacro
define-macro vcs-annotate
  3 vcs-id $buffer-fname "-annotate" "-blame"
!emacro
define-macro vcs-blame
  3 vcs-id $buffer-fname "-annotate" "-blame"
!emacro
define-macro vcs-checkout
  3 vcs-id $buffer-fname "-checkout"
!emacro
define-macro vcs-coci
  0 vcs-id
  !if &not $status
    @# rcs-file
  !elif &exi &set #l0 &cat #l9 "-coci"
    execute-named-command #l0
  !else
    -8 ml-write &spr "[VCS Error: %s does not support check-out-check-in]" &lget #l8 1
  !endif
!emacro
define-macro vcs-cat-file
  3 vcs-id $buffer-fname "-cat-file"
!emacro
define-macro vcs-commit
  3 vcs-id $buffer-fname "-commit"
!emacro
define-macro vcs-delete
  3 vcs-id $buffer-fname "-delete" "-remove"
!emacro
define-macro vcs-diff
  3 vcs-id $buffer-fname "-diff"
!emacro
define-macro vcs-fetch
  3 vcs-id $buffer-fname "-fetch"
!emacro
define-macro vcs-gdiff
  3 vcs-id $buffer-fname "-gdiff"
!emacro
define-macro vcs-info
  3 vcs-id $buffer-fname "-info"
!emacro
define-macro vcs-log-commit
  3 vcs-id $buffer-fname "-log-commit"
!emacro
define-macro vcs-log-file
  3 vcs-id $buffer-fname "-log-file"
!emacro
define-macro vcs-move
  3 vcs-id $buffer-fname "-move"
!emacro
define-macro vcs-pull
  3 vcs-id $buffer-fname "-update" "-pull"
!emacro
define-macro vcs-push
  3 vcs-id $buffer-fname "-push"
!emacro
define-macro vcs-remove
  3 vcs-id $buffer-fname "-delete" "-remove"
!emacro
define-macro vcs-resolve
  3 vcs-id $buffer-fname "-resolve"
!emacro
define-macro vcs-revert
  3 vcs-id $buffer-fname "-revert"
!emacro
define-macro vcs-setup
  3 vcs-id $buffer-fname "-setup"
!emacro
define-macro vcs-status
  3 vcs-id $buffer-fname "-status"
!emacro
define-macro vcs-switch
  3 vcs-id $buffer-fname "-switch"
!emacro
define-macro vcs-unstage
  3 vcs-id $buffer-fname "-unstage"
!emacro
define-macro vcs-update
  3 vcs-id $buffer-fname "-update" "-pull"
!emacro
