; -!- emf -!-
; Copyright (C) 2026 Detlef Groth, Unversity of Potsdam
;
; Synopsis:    Browse Markdown pages in MicroEmacs
; Authors:     Detlef Groth
;
; Usage:       mec @mdview <file.md>   - Markdown browsing for <file.md>
;              mec @mdvie              - Prompt for filename
;
execute-file "me"
execute-file "hkmdview"
0 define-macro start-up
  delete-other-windows
  !if &not &seq &set #l0 $buffer-fname ""
    !force 0 delete-buffer $buffer-bname
    mdview #l0
    delete-other-windows
  !else
    ; no topic seems to be given on the command line, load default info page
    mdview
    delete-other-windows
  !endif
!emacro
