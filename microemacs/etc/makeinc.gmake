# -*- Makefile -*-
#
# Get the platform name
#
ifneq ($(OS),Windows_NT)

UNAME:=$(shell echo `uname | tr '[A-Z]' '[a-z]'`)

else ifeq "$(shell uname -s | cut -c 1-9)" "CYGWIN_NT"

UNAME=cygwin

else ifeq "$(shell uname -s | cut -c 1-7)" "MSYS_NT"

UNAME=msyswin

else

UNAME=mingw
pc=\$(strip)
sc=& 

endif
#
# Find out the compiler.
#
WHICHCC:=$(shell echo `which cc`)
