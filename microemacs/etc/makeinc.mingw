# -*- Makefile -*-
# Make rules for Mingw
#
# MSYS 1 or 2?

ifneq "$(shell uname -s | cut -c 1-7)" "MSYS_NT"

$(error MSYS v1 no longer supported, use v2)

else

$(error MSYS2, use v2)

endif

# Use standard definitions
include $(TOPDIR)/etc/makeinc.std
#
# Host specific definitions
# 
TARGETDIR   =   $(UNAME)
#
# Set up the compiler Compiler
#
include $(TOPDIR)/etc/makeinc.gcc
#
# Platform specific defines.
#
CPP_PLATDEFS=   -D_MINGW -D_WIN32
